# Copy to .env for local development. On Replit, set these in the Secrets tool
# instead — never commit real keys.

# --- AI provider ---------------------------------------------------------
# auto = Gemini when GEMINI_API_KEY is set, otherwise a basic offline outline
AI_PROVIDER=auto
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any model your key can access; "gemini-flash-latest" tracks the current Flash model
GEMINI_MODEL=gemini-flash-latest
AI_TIMEOUT_SEC=120
AI_MAX_ATTEMPTS=3

# --- Speech recognition (faster-whisper, local CPU) -----------------------
# tiny | base | small  (use tiny on machines with <= 1 GB RAM)
WHISPER_MODEL=base
WHISPER_COMPUTE_TYPE=int8
WHISPER_CPU_THREADS=2
WHISPER_BEAM_SIZE=1
# vi | en | auto
DEFAULT_LANGUAGE=vi

# --- Limits ---------------------------------------------------------------
MAX_UPLOAD_MB=80
MAX_DURATION_SEC=600
MAX_FRAMES=8
FRAME_WIDTH=1280
FFMPEG_TIMEOUT_SEC=180
MAX_QUEUE_SIZE=3
JOB_TTL_HOURS=24

# --- Storage --------------------------------------------------------------
# DATA_DIR=./data
# MODEL_CACHE_DIR=./.cache/models

# --- Access control -------------------------------------------------------
# When set, the web UI asks for this shared password before any API call.
APP_PASSWORD=

# --- Video URL import (YouTube / Facebook) --------------------------------
# Validate URLs and show metadata (official oEmbed/APIs). true | false
URL_IMPORT_ENABLED=true
# Automatic media retrieval per platform. Keep "off" unless you have the rights
# AND the platform permits it (see README "URL import: compliance").
#   YOUTUBE_RETRIEVAL:  off | ytdlp
#   FACEBOOK_RETRIEVAL: off | graph_api | ytdlp   (graph_api = official, needs a token that can read the video)
YOUTUBE_RETRIEVAL=off
FACEBOOK_RETRIEVAL=graph_api
# Optional: YouTube Data API key (free quota) for duration / age / live checks
YOUTUBE_API_KEY=
# Optional: Meta token. App token -> oEmbed metadata; Page token -> your Page's videos (graph_api)
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_GRAPH_VERSION=v23.0
URL_MAX_DURATION_SEC=600
URL_MAX_DOWNLOAD_MB=80
URL_MAX_HEIGHT=480
DOWNLOAD_TIMEOUT_SEC=300
DOWNLOAD_SOCKET_TIMEOUT_SEC=20
DOWNLOAD_RETRIES=2
MAX_CONCURRENT_DOWNLOADS=1
# Requests/minute per IP on the URL endpoints; 0 = unlimited
URL_RATE_LIMIT_PER_MIN=0
