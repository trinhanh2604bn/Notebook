modules = ["python-3.11"]
run = "python -m uvicorn app.main:app --host 0.0.0.0 --port 8000"

[nix]
channel = "stable-24_05"
packages = ["ffmpeg-headless"]

[[ports]]
localPort = 8000
externalPort = 80

[env]
PYTHONUNBUFFERED = "1"

# Deployment is intentionally NOT configured. Background jobs need a process
# that stays alive, so Reserved VM is the suitable target; choose it (and its
# size/cost) yourself in the Publishing tool. See README "Deploying on Replit".
